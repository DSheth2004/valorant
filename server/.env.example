# Copy to .env for local development:  cp .env.example .env

# Local MongoDB (installed as a Windows service) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/valorant-hub

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=5000

# Only needed if the client is hosted on a different origin than the API (comma-separated)
# CLIENT_ORIGIN=http://localhost:5173
